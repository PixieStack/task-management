/* To learn more about TypeScript configuration files: https://www.typescriptlang.org/tsconfig. */
/* Angular 22 uses the @angular/build unit-test builder with Vitest. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "src/test-providers.ts"]
}
