# Application
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# Supabase Postgres - Task Manager project
# Keep the real database password only in backend/.env and deployment secrets.
SUPABASE_DB_HOST=db.mvxkssrpxaldmiknozoz.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password

# Optional explicit override. Production should normally use the Supabase values above.
# CI may intentionally use SQLite by setting DATABASE_URL itself.
# DATABASE_URL=sqlite:///./ci.db

# Local web + packaged Tauri app origins.
CORS_ORIGINS=http://localhost:4200,tauri://localhost,http://tauri.localhost
APP_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:8000

# Groq AI - keep the real key only in backend/.env or deployment secrets
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Brevo transactional email
# Registration VERIFICATION, password reset/change, account and contact emails use Brevo SMTP.
# Supabase Auth email delivery is NOT used by this application.
# Use a Brevo SMTP key here, NOT a Brevo API key.
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
SENDER_EMAIL=your-verified-sender@example.com
SENDER_NAME=M.O.B TaskManager
ADMIN_EMAIL=your-support-inbox@example.com

# OAuth provider client IDs.
# Google: OAuth 2.0 Web client ID with your web origins configured.
# Apple: Services ID configured for Sign in with Apple on the web.
# Provider authentication is verified by FastAPI; Supabase Auth is not used.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
